      <aliases enabled='yes' />
      <column caption='EV Sales' datatype='integer' name='[Calculation_0090503304409089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([electric_vehicles_sold])' />
      </column>
      <column caption='SUM([electric_vehicles_sold])' datatype='integer' name='[Calculation_0090503304777730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_vehicles_sold])' />
      </column>
      <column caption='EV Penetration %' datatype='real' default-format='p0%' name='[Calculation_0090503305007107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([total_vehicles_sold]) = 0 THEN NULL&#13;&#10;ELSE SUM([electric_vehicles_sold])/&#13;&#10;SUM([total_vehicles_sold]) END' />
      </column>
      <column caption='Maker Contribution % ' datatype='real' name='[Calculation_0090503305875460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([electric_vehicles_sold]) / TOTAL(SUM([electric_vehicles_sold]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption=' Month-over-Month Growth %' datatype='real' name='[Calculation_0090503306059781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOOKUP(SUM([electric_vehicles_sold]), -1)= 0 THEN NULL &#13;&#10;ELSE (SUM([electric_vehicles_sold]) - LOOKUP(SUM([electric_vehicles_sold]), -1)) /LOOKUP(SUM([electric_vehicles_sold]),-1)END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Year-over-Year Growth %' datatype='real' name='[Calculation_0090503309377542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LOOKUP(SUM([electric_vehicles_sold]), -12) = 0 THEN NULL &#13;&#10;ELSE (SUM([electric_vehicles_sold]) - LOOKUP(SUM([electric_vehicles_sold]), -12))/LOOKUP(SUM([electric_vehicles_sold]), -12)END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Month label ' datatype='string' name='[Calculation_0090503310217223]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[dates]) + &apos;&apos; + STR(YEAR([dates]))' />
      </column>
